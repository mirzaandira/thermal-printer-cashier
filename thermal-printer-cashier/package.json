{
  "name": "thermal-printer-cashier",
  "version": "1.0.0",
  "description": "Desktop POS application for 58mm thermal printer",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"pnpm dev:react\" \"pnpm dev:electron\"",
    "dev:react": "vite",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "build": "pnpm build:react && pnpm build:electron",
    "build:react": "vite build",
    "build:electron": "tsc src/main.ts --outDir dist --declaration false",
    "pack": "electron-builder --dir",
    "dist": "pnpm build && electron-builder",
    "lint": "eslint src --ext ts,tsx"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "sqlite3": "^5.1.6",
    "electron-squirrel-startup": "^1.1.0",
    "date-fns": "^3.0.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/electron": "^1.8.0",
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "electron": "^27.0.0",
    "electron-builder": "^24.0.0",
    "concurrently": "^8.2.0",
    "wait-on": "^7.0.1",
    "thermal-printer": "^0.4.11",
    "eslint": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "tailwindcss": "^3.3.0",
    "postcss": "^8.4.0",
    "autoprefixer": "^10.4.0"
  },
  "build": {
    "appId": "com.thermalcashier.app",
    "productName": "Thermal Printer Cashier",
    "files": [
      "dist/**/*",
      "node_modules/**/*"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
